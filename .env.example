# ==============================================================================
# Smart Redirect Proxy (SRP) — .env example (hardened)
# ------------------------------------------------------------------------------
# Copy to `.env` and fill in **only on the target server**. Never commit the real
# `.env` or expose it in tickets, screenshots, or logs.
#
#   cp .env.example .env && chmod 640 .env
#
# Generate fresh 64-char hex secrets with:
#   php -r "foreach(['AF_SECRET','SRP_API_KEY','POSTBACK_SECRET','SRP_RK_SECRET','CF_TOKEN_ENC_KEY'] as \$k) echo \$k.'='.bin2hex(random_bytes(32)).PHP_EOL;"
# ==============================================================================

# ── App runtime ───────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=0
APP_URL=https://example.com

# ── Database (required) ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=changeme_db_user
DB_PASSWORD=changeme_db_password
DB_NAME=changeme_db_name
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_PERSISTENT=0

# ── Admin / portal auth ───────────────────────────────────────────────────────
# Set real values on the server — never ship or commit these. The installer
# generates strong secrets for you; only fill these in for a manual install.
# Prefer the *_HASH variant of each (ADMIN_PASSWORD_HASH, A2ROOT_PASSWORD_HASH,
# ENV_EDITOR_PASSWORD_HASH); set one and the matching plaintext var is never read.
# Generate with:  php -r "echo password_hash('YOUR_STRONG_PASSWORD', PASSWORD_BCRYPT).PHP_EOL;"
#
# WARNING: A2ROOT_PASSWORD is a break-glass master override — it unlocks every
# tracker portal, the admin panel, and the stats admin view. Make it strong and
# unique; leaving it at a guessable value compromises the whole deployment.
ADMIN_PASSWORD=changeme_admin_password
A2ROOT_PASSWORD=changeme_strong_unique_master_password
# Gates install-dashboard.php (the status dashboard). The name is historical:
# it was the .env editor's password before that tool was removed. The installer
# half of that page uses install.token, not this.
ENV_EDITOR_PASSWORD=changeme_env_editor_password
# Redirect Decision panel. Bcrypt hash only, no plaintext fallback — leave empty
# to keep the panel locked until you set it. Generate with the command above.
RD_PASSWORD_HASH=

# ── cPanel API (addon-domain automation) ──────────────────────────────────────
CPANEL_USER=changeme_cpanel_user
CPANEL_PASSWORD=
CPANEL_HOST=server.example-host.com
CPANEL_PORT=2083
CPANEL_SUBDOMAIN_DIR=path/to/redirect
CPANEL_API_TOKEN=changeme_cpanel_api_token
CPANEL_SSL_VERIFY=1

# ── Addon-domain DNS gate ─────────────────────────────────────────────────────
# Storage-time check only: BLOCKS names that do not resolve at all (typos or a
# domain that was never registered). Onboarding is circular — the operator
# cannot point the domain at us until zone creation has told them the
# Cloudflare nameservers, so demanding more than "does it resolve" at storage
# time would block the very first step.
ADDON_DNS_PRECHECK=1

# ── Cloudflare API (zone automation & WAF hardening) ──────────────────────────
CF_API_TOKEN=changeme_cloudflare_api_token
# SSL/TLS mode the sync pins on every zone (off|flexible|full|strict).
# Leave at full: cfPinSslMode() also opts the zone out of Cloudflare's
# Automatic SSL/TLS, which otherwise moves zones to strict on its own and
# then answers 526 for any hostname whose Origin CA cert did not install.
CF_SSL_MODE=full
CF_ACCOUNT_ID=changeme_cloudflare_account_id
# Origin IP used for Cloudflare DNS provisioning and readiness checks. A
# cPanel-only domain is "active" only when its public A/AAAA result matches it.
CF_SERVER_IP=127.0.0.1

# Extra zone settings (h2_prioritization, fonts) — verified working on a Free
# zone, so this is on by default.
CF_APPLY_OPTIONAL_SETTINGS=1
# Paid add-ons (polish, mirage, image_resizing, speed_brain). On by default so
# every recommended setting is applied; each is a best-effort PATCH, so on an
# account without these entitlements Cloudflare rejects them and it just shows
# up as a cf_warnings toast in the admin panel, never a hard failure. Set to 0
# to silence those warnings on a plan that doesn't have them.
CF_APPLY_PAID_FEATURES=1
# Lets the Meta crawler past the WAF so Facebook/WhatsApp link previews work.
# Matches Meta ASN *and* Meta user agent, so it is not a spoofable bypass.
CF_ENABLE_FACEBOOK_OG_WAF_SKIP=1

# Origin certificate auto-issuance (optional)
CF_ORIGIN_CERT_AUTO_INSTALL=0
CF_ORIGIN_CERT_TYPE=origin-rsa
CF_ORIGIN_CERT_VALIDITY_DAYS=5475
CF_ORIGIN_CERT_INSTALL_TARGET=wildcard
CF_ORIGIN_CERT_ONE_CERT_PER_DOMAIN=1
CF_ORIGIN_CERT_REQUIRE_WILDCARD_TARGET=1
CF_ORIGIN_CERT_INCLUDE_WILDCARD=1
CF_ORIGIN_CERT_INCLUDE_APEX=0
CF_ORIGIN_CERT_EXCLUDE_DOMAINS=example.com
# Leave at 0. Setting the zone to Full (strict) after installing an Origin CA
# cert was the cause of a 526 outage: the cert covers only *.domain, but
# strict makes Cloudflare validate every hostname on the zone — including
# the apex, which is not in the SAN list. SSL mode is owned by CF_SSL_MODE.
CF_ORIGIN_CERT_SET_STRICT=0

# Nameservers — auto-populated by panel after zone activation
CF_NS1=
CF_NS2=
CF_NS3=
CF_NS4=

# ── Secrets (generate & paste — see header command) ───────────────────────────
AF_SECRET=changeme_64char_hex_secret
SRP_API_KEY=changeme_64char_hex_secret

# HMAC key for signing the internal `rk` redirect token (redirect/ → _meetups/).
# Prevents forged rk from inflating click counts. If unset, the redirect engine
# falls back to another app secret above (a warning is logged) — set a dedicated
# key here. Generate with:  php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
SRP_RK_SECRET=changeme_64char_hex_secret

# Encryption key for per-user Cloudflare API tokens stored in generate.cf_token
# (libsodium secretbox). 64 hex chars = 32 bytes. If unset, tokens are stored as
# plaintext (a warning is logged). Generate with:
#   php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# Rotating this key makes already-encrypted tokens unreadable — users must re-enter
# their Cloudflare token from the portal after a rotation.
CF_TOKEN_ENC_KEY=changeme_64char_hex_secret
# Per-IP rate limit for redirect/api/shorten.php (requests/minute, fail-open).
# Generous default; only caps flooding. Set 0 to disable.
SRP_SHORTEN_RATE_PER_MIN=300

# ── External shorteners (optional fallbacks) ──────────────────────────────────
TRACKR_API_KEY=
TRACKR_ENDPOINT=
TINYURL_API_KEY=

# ── Reporting ─────────────────────────────────────────────────────────────────
REPORT_HOST=s.example.com

# ── Geo-blocking ──────────────────────────────────────────────────────────────
# Comma-separated ISO country codes sent to SRP_BLOCK_URL instead of the offer.
# Applies to direct-mode links only; landing-mode links stay reachable everywhere.
SRP_BLOCK_COUNTRIES=ID
# Where those visitors go. Must be https. Leave empty to use the built-in
# default (https://www.youtube.com/).
SRP_BLOCK_URL=

# ── Offer allowlist ──────────────────────────────────────────────────────────
# Comma-separated domains allowed as the FINAL offer / shortlink destination.
# Empty (default) = allow any https domain. When set, only these domains and
# their subdomains are served; anything else is rejected and audit-logged.
SRP_OFFER_ALLOWED_DOMAINS=

# ── Timed filter ──────────────────────────────────────────────────────────────
SRP_FILTER_URL="https://filter.example.com/?utm_source=changeme"
SRP_CYCLE_SECONDS=300
SRP_FILTER_SECONDS=120

# ── Social preview (Open Graph) ───────────────────────────────────────────────
# Default description served on the crawler-facing preview page (og:description,
# meta description, twitter:description and visible body text). Keep it neutral.
# Optional — leave unset or empty to use the built-in default
# "Open this link to view the content.".
SRP_OG_DESCRIPTION="Open this link to view the content."

# ── GeoIP update ──────────────────────────────────────────────────────────────
MAXMIND_LICENSE_KEY=changeme_maxmind_license_key
# Optional. Leave empty unless update-geoip.php fails with HTTP 401 despite a
# correct, active license key — that means MaxMind only granted this account
# the newer Basic Auth download method. Find it on the same "My License Keys"
# page as the key above and set it here to switch to that method.
MAXMIND_ACCOUNT_ID=

# ── Postback (conversion receiver) ────────────────────────────────────────────
# Required — the postback endpoint returns 500 SERVER_ERROR if this is empty.
POSTBACK_SECRET=changeme_64char_hex_secret
# Keep this UTC. The click writer (redirect/) and every statistics reader derive
# the click_date / conversion_date day in UTC; the postback receiver uses this
# value for the same columns. Setting it to a non-UTC zone makes postback-created
# clickrecord rows land on a different calendar day than the click that created
# them, breaking the day-join used for conversion attribution and payout.
POSTBACK_TIMEZONE=UTC

# ── Optional features ─────────────────────────────────────────────────────────
# Secret that unlocks the cloak diagnostic panel (click_id, ip, country, asn,
# vpn, device, ua) on the OG page served to cloaked traffic. Append
# ?dbg=<this value> to the redirect URL to see it; without a match the page is
# byte-identical to what a crawler gets. Empty = feature disabled.
# Generate with:  php -r "echo bin2hex(random_bytes(16)).PHP_EOL;"
# Note: query strings land in access logs, so rotate it if it leaks.
SRP_CLOAK_DEBUG_KEY=1
# Relaxes the redirect engine's CSP (script-src/connect-src) so Cloudflare Web
# Analytics, if enabled for this zone in the Cloudflare dashboard, is not
# blocked. Cloudflare injects its own beacon at the edge — no token needed here.
SRP_ALLOW_CLOUDFLARE_INSIGHTS=0
