const JSON_FLAGS = JSON_UNESCAPED_UNICODE
    | JSON_UNESCAPED_SLASHES
    | JSON_HEX_TAG
    | JSON_HEX_AMP
    | JSON_HEX_APOS
    | JSON_HEX_QUOT
    | JSON_THROW_ON_ERROR;

function jsonResponse(array $payload, int $statusCode = 200): never
{
    http_response_code($statusCode);

    try {
        echo json_encode($payload, JSON_FLAGS);
    } catch (Throwable $e) {
        http_response_code(500);
        echo '[{"shorturl":null,"error":"JSON encode failed"}]';
    }

    exit;
}

/**
 * @param array<string, mixed> $context
 */
function apiLog(string $message, array $context = []): void
{
    try {
        $safeContext = json_encode($context, JSON_FLAGS);
    } catch (Throwable $e) {
        $safeContext = '{}';
    }

    error_log('[generate_api] ' . $message . ' ' . $safeContext);
}

function isAllowedHttpUrl(string $url): bool
{
    if ($url === '' || strlen($url) > 5000) {
        return false;
    }

    if (preg_match('/[\x00-\x20\x7F]/', $url) === 1) {
        return false;
    }

    if (filter_var($url, FILTER_VALIDATE_URL) === false) {
        return false;
    }

    $scheme = strtolower((string) parse_url($url, PHP_URL_SCHEME));
    $host = (string) parse_url($url, PHP_URL_HOST);

    return $host !== '' && ($scheme === 'http' || $scheme === 'https');
}

function isLikelyShortenerErrorText(string $value): bool
{
    $cleanValue = trim($value);

    if ($cleanValue === '') {
        return true;
    }

    return preg_match('/^(error|failed|invalid|unauthorized|forbidden|method not allowed|database insert failed)(\b|[:,])/i', $cleanValue) === 1
        || preg_match('/database\s+insert\s+failed/i', $cleanValue) === 1;
}

function extractShortUrlFromResponse(mixed $payload): ?string
{
    if (is_string($payload)) {
        $candidate = trim($payload);
        if (isLikelyShortenerErrorText($candidate)) {
            return null;
        }
        if (isAllowedHttpUrl($candidate)) {
            return $candidate;
        }

        return null;
    }

    if (!is_array($payload)) {
        return null;
    }

    $preferredKeys = [
        'shorturl',
        'short_url',
        'shortUrl',
        'url',
        'short',
        'result',
        'data',
        'link',
    ];

    foreach ($preferredKeys as $key) {
        if (array_key_exists($key, $payload)) {
            $found = extractShortUrlFromResponse($payload[$key]);
            if ($found !== null) {
                return $found;
            }
        }
    }

    foreach ($payload as $value) {
        $found = extractShortUrlFromResponse($value);
        if ($found !== null) {
            return $found;
        }
    }

    return null;
}

function requestTrackrShortUrl(string $longUrl, string $shortlinkDomain = ''): ?string
{
    if (!function_exists('curl_init')) {
        return null;
    }

    $apiKey = app_env('TRACKR_API_KEY', '');

    // Derive endpoint: prefer the base domain of the generated URL
    if ($shortlinkDomain !== '') {
        $endpoint = 'https://' . $shortlinkDomain . '/api/shorten';
    } else {
        $endpoint = app_env('TRACKR_ENDPOINT', '');
    }
    if ($endpoint === '') {
        return null;
    }

    if ($apiKey === '') {
        return null;
    }

    $parsedLongUrl = parse_url($longUrl);
    if (
        !is_array($parsedLongUrl)
        || !isset($parsedLongUrl['scheme'], $parsedLongUrl['host'])
        || strtolower((string) $parsedLongUrl['scheme']) !== 'http'
    ) {
        return null;
    }

    $path = isset($parsedLongUrl['path']) ? trim((string) $parsedLongUrl['path'], '/') : '';
    $subId = $path !== '' ? basename($path) : '';
    if ($subId === '' || strlen($subId) > 2048 || preg_match('/^[A-Za-z0-9_-]+$/', $subId) !== 1) {
        return null;
    }

    $baseUrl = 'http://' . (string) $parsedLongUrl['host'];
    $ch = curl_init($endpoint);
    if ($ch === false) {
        return null;
    }

    $postFields = json_encode(
        [
            'sub_id' => $subId,
            'base_url' => $baseUrl,
        ],
    );
    if (!is_string($postFields)) {
        return null;
    }

    curl_setopt_array(
        $ch,
        [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => $postFields,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_CONNECTTIMEOUT => 3,
            CURLOPT_TIMEOUT => 8,
            CURLOPT_FOLLOWLOCATION => false,
            CURLOPT_HTTPHEADER => [
                'Accept: application/json, text/plain, */*',
                'Content-Type: application/json',
                'Authorization: Bearer ' . $apiKey,
            ],
            CURLOPT_SSL_VERIFYPEER => true,
            CURLOPT_SSL_VERIFYHOST => 2,
        ],
    );

    $response = curl_exec($ch);
    $httpCode = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $curlError = curl_error($ch);
    curl_close($ch);

    if ($response === false || $curlError !== '') {
        apiLog('trackr_transport_failed', [
            'http_code' => $httpCode,
            'curl_error_hash' => hash('sha256', $curlError),
        ]);

        return null;
    }

    if ($httpCode < 200 || $httpCode > 299) {
        apiLog('trackr_http_error', [
            'http_code' => $httpCode,
        ]);

        return null;
    }

    $raw = trim((string) $response);
    if ($raw === '' || isLikelyShortenerErrorText($raw)) {
        apiLog('trackr_error_body', [
            'http_code' => $httpCode,
            'body_len' => strlen($raw),
            'body_hash' => hash('sha256', $raw),
        ]);

        return null;
    }

    try {
        $decoded = json_decode($raw, true, 32, JSON_THROW_ON_ERROR);
        $shortUrl = extractShortUrlFromResponse($decoded);
        if ($shortUrl !== null && isAllowedHttpUrl($shortUrl)) {
            return $shortUrl;
        }
    } catch (Throwable $e) {
        apiLog('trackr_non_json_response', [
            'http_code' => $httpCode,
            'body_len' => strlen($raw),
            'body_hash' => hash('sha256', $raw),
        ]);
    }

    if (!isLikelyShortenerErrorText($raw) && isAllowedHttpUrl($raw)) {
        return $raw;
    }

    return null;
}

function createBuiltinShortUrl(string $longUrl, PDO $pdo, string $ogTitle = '', string $ogImage = ''): ?string
{
    $host = (string) parse_url($longUrl, PHP_URL_HOST);
    if ($host === '') {
        return null;
    }

    // The `shortlinks` table is provisioned by the installer (schema.sql); the
    // previous per-request information_schema existence probe was removed. If the
    // table is absent the INSERT below throws → caught → returns null (caller
    // then falls back to Trackr / raw URL), the same outcome as before.
    for ($attempt = 0; $attempt < 5; $attempt++) {
        $code = substr(base_convert(bin2hex(random_bytes(4)), 16, 36), 0, 7);
        $now  = time();

        try {
            $stmt = $pdo->prepare('INSERT IGNORE INTO shortlinks (code, long_url, og_title, og_image, created_at) VALUES (:code, :long_url, :og_title, :og_image, :created_at)');
            if (!$stmt) {
                continue;
            }
            $stmt->execute([
                'code' => $code,
                'long_url' => $longUrl,
                'og_title' => $ogTitle,
                'og_image' => $ogImage,
                'created_at' => $now,
            ]);
            $inserted = $stmt->rowCount();
            if ($inserted > 0) {
                return 'http://' . $host . '/s-' . $code;
            }
        } catch (Throwable $e) {
            apiLog('builtin_shortlink_insert_failed', [
                'class' => get_class($e),
                'code' => (string) $e->getCode(),
                'attempt' => $attempt + 1,
            ]);

            return null;
        }
    }

    return null;
}

function fetchRandomAddonDomain(PDO $pdo, string $subDomain): ?string
{
    $rangeStmt = $pdo->prepare(
        'SELECT MIN(id) AS min_id, MAX(id) AS max_id FROM addondomain WHERE sub_domain = :sub_domain',
    );
    $rangeStmt->execute(['sub_domain' => $subDomain]);
    $range = $rangeStmt->fetch(PDO::FETCH_ASSOC);

    if (!is_array($range) || $range['min_id'] === null || $range['max_id'] === null) {
        return null;
    }

    $minId = (int) $range['min_id'];
    $maxId = (int) $range['max_id'];
    if ($minId < 1 || $maxId < $minId) {
        return null;
    }

    $randomId = random_int($minId, $maxId);
    $domain = fetchAddonDomainAtOrAfterId($pdo, $subDomain, $randomId);

    return $domain ?? fetchAddonDomainAtOrAfterId($pdo, $subDomain, $minId);
}

function fetchAddonDomainAtOrAfterId(PDO $pdo, string $subDomain, int $minimumId): ?string
{
    $stmt = $pdo->prepare(
        'SELECT domain FROM addondomain WHERE sub_domain = :sub_domain AND id >= :min_id ORDER BY id ASC LIMIT 1',
    );
    $stmt->execute(['sub_domain' => $subDomain, 'min_id' => $minimumId]);
    $row = $stmt->fetch(PDO::FETCH_ASSOC);

    if (!is_array($row) || empty($row['domain']) || !is_string($row['domain'])) {
        return null;
    }

    return $row['domain'];
}

if (($_SERVER['REQUEST_METHOD'] ?? '') !== 'POST') {
    jsonResponse([['shorturl' => null, 'error' => 'Method Not Allowed']], 405);
