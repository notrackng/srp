function randomTokenPrefix(int $length = 5): string
{
    $chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    $max = strlen($chars) - 1;
    $result = '';
    for ($i = 0; $i < $length; $i++) {
        $result .= $chars[random_int(0, $max)];
    }

    return $result;
}

function randomShortlinkSubdomain(): string
{
    $alphabet = str_split('abcdefghijklmnopqrstuvwxyz0123456789');
    $label = '';
    $targetLength = 5;

    while (strlen($label) < $targetLength) {
        $index = random_int(0, count($alphabet) - 1);
        $label .= $alphabet[$index];
        array_splice($alphabet, $index, 1);
    }

    return $label;
}

try {
    $url = (string) ($_POST['longurl'] ?? '');
    $id = (string) ($_POST['id'] ?? '');
    $requestedSubId = (string) ($_POST['sub_id'] ?? '');
    $subId = generateApiResolveAuthorizedSubId($sessionSubId, $requestedSubId);
    $pickurl = (string) ($_POST['pickurl'] ?? '');
    $canonicalUrl = (string) ($_POST['longurl'] ?? '');
    $userLp = (string) ($_POST['user_lp'] ?? '');
    $fbtext = (string) ($_POST['fbtext'] ?? '');
    $fbimg = (string) ($_POST['fbimg'] ?? '');
    $lg = (string) ($_POST['lg'] ?? '');
    $blockVpnAsnRaw = $_POST['block_vpn_asn'] ?? '1';
    $blockVpnAsn = (!is_string($blockVpnAsnRaw)
        || !in_array(strtolower(trim($blockVpnAsnRaw)), ['0', 'false', 'off', 'no'], true)) ? '1' : '0';

    if ($subId === null) {
        jsonResponse(
            [
                [
                    'shorturl' => null,
                    'error' => 'Forbidden',
                ],
            ],
            403,
        );
    }

    if ($url === '') {
        jsonResponse(
            [
                [
                    'shorturl' => null,
                    'error' => 'Missing longurl',
                ],
            ],
            400,
        );
    }

    if ($fbtext === '') {
        $t = "Hi! I'm: " . ucwords(randomName()) . ' - On live shows!';
    } else {
        $t = $fbtext;
    }

    $genurl = $url;
    $useHostEndpoint = false;
    if ($url === 'https://{sub}.global/{click_id}' || $url === 'http://{sub}.global/{click_id}') {
        $domain = fetchRandomAddonDomain($pdo, 'global');
        if ($domain !== null) {
            $genurl = 'http://{sub}.' . $domain . '/{click_id}';
            $useHostEndpoint = true;
        }
    } elseif ($url === 'https://{sub}.u_rand/{click_id}' || $url === 'http://{sub}.u_rand/{click_id}') {
        $domain = fetchRandomAddonDomain($pdo, $subId);
        if ($domain !== null) {
            $genurl = 'http://{sub}.' . $domain . '/{click_id}';
            $useHostEndpoint = true;
        }
    }

    $sp = randomShortlinkSubdomain();
    $strParam = ['{sub}', '{click_id}'];
    $strBuild = [
        $sp,
        base64url_encode(
            randomTokenPrefix(5)
            . ',' . strtoupper($subId)
            . ',' . time()
            . ',' . (isAllowedHttpUrl($canonicalUrl) ? $canonicalUrl : '')
            . ',' . $userLp
            . ',' . $t
            . ',' . (isAllowedHttpUrl($fbimg) ? $fbimg : '')
            . ',' . $lg
            . ',' . $blockVpnAsn,
        ),
    ];

    $urlEx = str_replace($strParam, $strBuild, htmlspecialchars_decode($genurl, ENT_QUOTES));
    $urlEx = preg_replace('/^https:\/\//i', 'http://', $urlEx) ?? $urlEx;

    if (!isAllowedHttpUrl($urlEx)) {
        jsonResponse(
            [
                [
                    'shorturl' => null,
                    'error' => 'Generated URL is invalid',
                ],
            ],
            400,
        );
    }

    /*
     * Legacy compatibility:
     * $id dan $pickurl tetap diterima agar caller lama tidak pecah,
     * tetapi Branch sudah dihapus total.
     */
    unset($id, $pickurl);

    // "Long URL" mode: caller opted out of shortening — return the raw long URL
    // (http://<domain>/<base64url-payload>) without the built-in or external
    // shortener. Default (noshorten absent / '0') keeps the existing behavior.
    $noShorten = (($_POST['noshorten'] ?? null) === '1');

    if ($noShorten) {
        $_short = $urlEx;
    } else {
        // Built-in shortener: store long URL + OG data in DB, return http://host/s-code
        $_short = createBuiltinShortUrl($urlEx, $pdo, $t, $fbimg);
        if ($_short === null) {
            // Fallback: external Trackr (global/u_rand pool domains only)
            $generatedHost = $useHostEndpoint ? (string) parse_url($urlEx, PHP_URL_HOST) : '';
            $_short = requestTrackrShortUrl($urlEx, $generatedHost);
        }
        if ($_short === null) {
            $_short = $urlEx;
        }
    }

    $_short = preg_replace('/^https:\/\//i', 'http://', $_short) ?? $_short;

    jsonResponse(
        [
            [
                'shorturl' => $_short,
            ],
        ],
    );
} catch (Throwable $e) {
    jsonResponse(
        [
            [
                'shorturl' => null,
                'error' => 'Internal Server Error',
            ],
        ],
        500,
    );
}
